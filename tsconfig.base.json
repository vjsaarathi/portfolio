{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@impossible-resume/event-bus": ["packages/event-bus/src"],
      "@impossible-resume/runtime-tracker": ["packages/runtime-tracker/src"],
      "@impossible-resume/design-tokens": ["packages/design-tokens"],
      "@impossible-resume/framework-adapters": ["packages/framework-adapters/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
