    {
      "id": "aarPaL6AGnsDmEKCmmf6R",
      "type": "text",
      "x": 1147.98828125,
      "y": -3.1640625,
      "width": 601.7593994140625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
