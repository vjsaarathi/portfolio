      "seed": 1709110932,
      "version": 319,
      "versionNonce": 779440445,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788959378569,
      "link": null,
      "locked": false,
      "text": "Implemented in Native C++/C code\nis part of the JVM itself, created by JVM when it boots up\nhas no java Object representation, is the parent delegate of \nPlatform class loader.\nLoads initial classes that you can use without importing\nex: System, Thread, Class, Integer, Long etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implemented in Native C++/C code\nis part of the JVM itself, created by JVM when it boots up\nhas no java Object representation, is the parent delegate of \nPlatform class loader.\nLoads initial classes that you can use without importing\nex: System, Thread, Class, Integer, Long etc.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LyBpBpAUtRY5A8wBklS3s",
      "type": "text",
      "x": 1151.75,
      "y": 268.78515625,
      "width": 633.7794799804688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1903153857,
      "version": 374,
      "versionNonce": 456207635,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788959378569,
      "link": null,
      "locked": false,
      "text": "Created by JVM along side Bootstrap CL, is a java object. \nhas the responsibility of loading SDK classes that ship with JDK\nex: java.io.InputStream, java.util.List etc",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Created by JVM along side Bootstrap CL, is a java object. \nhas the responsibility of loading SDK classes that ship with JDK\nex: java.io.InputStream, java.util.List etc",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
