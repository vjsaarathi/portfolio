{
  "name": "the-impossible-resume",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build-all.sh",
    "build:shell": "cd apps/shell && bun run build",
    "build:landing": "cd apps/landing && bun run build",
    "build:projects": "cd apps/projects && bun run build",
    "build:blog": "cd apps/blog && bun run build",
    "build:contact": "cd apps/contact && bun run build",
    "build:playground": "cd apps/playground && bun run build",
    "build:devtools": "cd apps/devtools && bun run build",
    "deploy": "bash scripts/deploy.sh",
    "manifest": "node scripts/generate-manifest.js"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@formspree/react": "^2.5.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vue/compiler-sfc": "^3.4.21",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "d3": "^7.9.0",
    "gh-pages": "^6.1.1",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^3.3.4",
    "svelte": "^4.2.12",
    "svelte-loader": "^3.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.3",
    "vue": "^3.4.21",
    "vue-loader": "^17.4.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
